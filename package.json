{
  "name": "taskiye",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"pnpm --filter @taskiye/server dev\" \"pnpm --filter @taskiye/client dev\"",
    "start": "pnpm --filter @taskiye/server start",
    "build": "pnpm run build:client && pnpm run build:server",
    "build:client": "pnpm --filter @taskiye/client build",
    "build:server": "pnpm --filter @taskiye/server build",
    "seed": "pnpm --filter @taskiye/server seed",
    "lint": "eslint .",
    "test": "vitest run",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,css,md}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.20.1",
    "@playwright/test": "^1.63.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.20.1",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "prettier": "^3.5.2",
    "typescript-eslint": "^8.24.1",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@10.28.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "qs@>=6.14.2 <=6.15.3": ">=6.16.0",
      "qs@>=2.2.5 <6.16.0": ">=6.16.0",
      "multer@>=2.2.0 <2.4.0": ">=2.4.0",
      "brace-expansion@>=4.0.0 <5.0.12": ">=5.0.12"
    }
  }
}
